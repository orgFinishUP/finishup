{"$id":"https://schemas.yoetz.dev/0.1/service/rest-agent-declaration-1.0.0.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"``rest-agent-declaration`` 1.0.0 (``POST /v1/agents`` body): the operations the agent\nanswers, its largest reply, and its role (``connection`` or the helper's ``background``).","properties":{"max_reply_bytes":{"maximum":6291456,"minimum":1,"title":"Max Reply Bytes","type":"integer"},"operations":{"items":{"pattern":"^[a-z][a-z0-9_]{0,63}$","type":"string"},"maxItems":64,"minItems":1,"title":"Operations","type":"array","uniqueItems":true},"role":{"enum":["background","connection"],"title":"Role","type":"string"},"schema_version":{"const":"1.0.0","title":"Schema Version","type":"string"}},"required":["max_reply_bytes","operations","role","schema_version"],"title":"rest-agent-declaration","type":"object"}