{"$id":"https://schemas.yoetz.dev/0.1/service/rest-error-1.0.0.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"``rest-error`` 1.0.0: a transport or authentication refusal, by its closed reason.","properties":{"reason":{"enum":["agent_limit","agent_unknown","api_key_expired","api_key_invalid","api_key_revoked","api_manifest_unsupported","frame_invalid","frame_too_large","header_invalid","internal_failure","method_not_allowed","operation_limit","operation_unknown","origin_forbidden","rate_limited","route_unknown","server_keys_unusable","server_profile_changed","service_unavailable","workspace_agent_unavailable","workspace_claim_required"],"title":"Reason","type":"string"},"schema_version":{"const":"1.0.0","title":"Schema Version","type":"string"}},"required":["reason","schema_version"],"title":"rest-error","type":"object"}