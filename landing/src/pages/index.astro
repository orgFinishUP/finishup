---
import "../styles/tokens.css";
import "../styles/landing.css";
import "@fontsource/geist/latin-400.css";
import "@fontsource/geist/latin-500.css";
import "@fontsource/geist/latin-600.css";
import "@fontsource/geist-mono/latin-400.css";
import "@fontsource/geist-mono/latin-500.css";
import "@fontsource/newsreader/latin-400.css";
import "@fontsource/newsreader/latin-500.css";
import landingPackage from "../../package.json";

const SITE = "https://finishup.dev";
const GITHUB = "https://github.com/orgFinishUP/finishup";
const DOCS = `${GITHUB}/tree/main/docs/usage`;
// PyPI and npm installs are documented here; the page sends people to it rather than repeating it.
const INSTALL_GUIDE = `${GITHUB}/blob/main/docs/usage/install-and-first-run.md`;
const CONTACT_EMAIL = "support@finishup.dev";
const VERSION = landingPackage.version;
const AGENT_PROMPT = `Install FinishUP for me (${GITHUB}). Fetch its agent install guide and follow "The short version" at the top:

curl -fsSL https://raw.githubusercontent.com/orgFinishUP/finishup/main/docs/usage/agent-start.md

If your sandbox blocks that fetch, ask me to approve it or to paste the guide. Setup's questions are mine to answer, so ask me each one and wait, and show me any proposed change before it is applied. Never ask me for a key or password in chat; hand me the terminal for those.`;
const TITLE = "FinishUP: agents start, FinishUP checks";
// The link-preview card. Bump `v` whenever og.png changes: link previews cache the image by
// its URL, so an unchanged URL keeps showing the old card.
const OG_IMAGE = `${SITE}/assets/og.png?v=2`;
const DESCRIPTION =
  "FinishUP checks recorded work evidence and shows what remains open. Open source, with local checks and optional AI-powered review. For Codex, Claude Code, and Cursor.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "FinishUP",
  description: DESCRIPTION,
  url: SITE,
  codeRepository: GITHUB,
  programmingLanguage: "Python",
  version: VERSION,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
};

// The scroll story: one scene at a time, in order. `screens` is how many viewport
// heights the scene spans, tuned so every copy beat and particle transition stay in sync.
const plan = [
  ["hero", 0.95],
  ["alone", 1.25],
  ["swarm", 1.25],
  ["robot", 2.85],
  ["end", 0.95],
];
// Brief hold for the finished lockup before the footer glides in.
const END_HOLD = 0.25;
const STORY_SCREENS = plan.reduce((sum, [, len]) => sum + (len as number), 0) + END_HOLD;

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href="/assets/finishup-mark.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/finishup-mark.png" />
    <meta name="theme-color" content="#fafdf9" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:site_name" content="FinishUP" />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="The FinishUP logo beside the line: Agents start. FinishUP checks. Open source, local checks, free." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content="The FinishUP logo beside the line: Agents start. FinishUP checks. Open source, local checks, free." />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline type="application/json" id="story-plan" set:html={JSON.stringify(plan)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to the story</a>
    {/* The menu holds the only control that pauses the artwork, so it comes straight after the
        skip link, where a keyboard reaches it before the nav and the story. CSS fixes it to the
        right edge of the window wherever it sits in the source. The panel follows its trigger, so
        Tab goes from the trigger into the open panel. */}
    <aside class="a11y-menu" id="a11y-menu" aria-label="Accessibility options" hidden>
      <button class="a11y-trigger" id="a11y-trigger" type="button" aria-expanded="false" aria-controls="a11y-panel" aria-label="Accessibility options" title="Accessibility options">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="4.5" r="2" />
          <path d="M4.5 9h15" />
          <path d="M12 9v5.5" />
          <path d="M8.5 21 12 14.5 15.5 21" />
        </svg>
      </button>
      <div class="a11y-panel" id="a11y-panel" role="region" aria-label="Accessibility settings" hidden>
        <div class="a11y-head">
          <span class="a11y-title">Accessibility</span>
          <button class="a11y-close" id="a11y-close" type="button" aria-label="Close accessibility menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </div>
        {/* Each switch is named by the label drawn beside it and keeps that name. Whether it is on
            is said by aria-checked alone: a name that changed with the state would be announced
            as the opposite of what the switch shows. */}
        <div class="a11y-row" id="motion-row">
          <div class="a11y-label">
            <span class="a11y-name" id="motion-name">Pause motion</span>
            <span class="a11y-desc" id="motion-desc">Show crisp still artwork</span>
          </div>
          <button class="a11y-switch" id="motion-toggle" type="button" role="switch" aria-checked="false" aria-controls="story" aria-labelledby="motion-name" aria-describedby="motion-desc" hidden>
            <span class="a11y-knob" aria-hidden="true"></span>
          </button>
        </div>
        <p class="a11y-note" id="a11y-reduced-note" hidden>System reduced motion is active — showing still artwork.</p>
        <div class="a11y-row" id="graphics-row">
          <div class="a11y-label">
            <span class="a11y-name" id="graphics-name">Text only</span>
            <span class="a11y-desc" id="graphics-desc">Hide decorative dot artwork</span>
          </div>
          <button class="a11y-switch" id="graphics-toggle" type="button" role="switch" aria-checked="false" aria-controls="story" aria-labelledby="graphics-name" aria-describedby="graphics-desc">
            <span class="a11y-knob" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </aside>
    <header class="nav">
      <div class="nav-inner">
        <a class="lockup" href="#top" aria-label="FinishUP home"><img src="/assets/finishup-lockup.png" alt="FinishUP" height="32" /></a>
        <nav class="nav-links" aria-label="Site">
          <a class="lnk" href={INSTALL_GUIDE} target="_blank" rel="noopener">Install</a>
          <a class="lnk" href={DOCS} target="_blank" rel="noopener">Docs</a>
          <a class="lnk" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <button class="btn sm add-agent" type="button" aria-label="Set up with your agent" data-prompt={AGENT_PROMPT} hidden>Set up</button>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="story" id="story" data-screens={STORY_SCREENS}>
        <div class="stage">
          <canvas id="particles" aria-hidden="true"></canvas>
          <div class="copies">
          <div class="copy hero on" data-copy="hero">
            <h1 class="stanza center hero-top">We use agents for <span class="hero-word">work, code, research and more.</span></h1>
            <canvas class="still-art still-hero" data-still-form="hero" data-still-phase="0" aria-hidden="true"></canvas>
            <div class="hero-bottom">
              <p class="stanza center"><span class="nowrap"><img class="fup-mark" src="/assets/finishup-mark.png" alt="" />FinishUP</span> <span class="accent">helps them finish.</span></p>
              <div class="actions">
                <button class="btn add-agent" type="button" data-prompt={AGENT_PROMPT} hidden>Set up with your agent</button>
                <a class="btn quiet" href={GITHUB} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" /></svg> Visit our GitHub</a>
                <noscript><a class="btn" href={INSTALL_GUIDE}>Install and setup guide</a></noscript>
              </div>
            </div>
          </div>
          <div class="copy side" data-copy="alone">
            <canvas class="still-art still-scene" data-still-form="alone" data-still-phase="0.45" aria-hidden="true"></canvas>
            <p class="stanza copy-right">We used to work alone. <span class="fade">Slowly.</span></p>
          </div>
          <div class="copy side" data-copy="swarm">
            <canvas class="still-art still-scene" data-still-form="swarm" data-still-phase="0.5" aria-hidden="true"></canvas>
            <div class="copy-right">
              <p class="stanza">Now agents work. <span class="fade">We manage more.</span></p>
            </div>
          </div>
          <div class="copy side" data-copy="robot1">
            <canvas class="still-art still-scene" data-still-form="robot" data-still-phase="0.22" aria-hidden="true"></canvas>
            <p class="stanza copy-right">But agents aren't human. <span class="fade">They drift. They forget.</span></p>
          </div>
          <div class="copy side" data-copy="robot2">
            <canvas class="still-art still-scene" data-still-form="robot" data-still-phase="0.55" aria-hidden="true"></canvas>
            <p class="stanza copy-right">FinishUP checks the work record.</p>
          </div>
          <div class="copy side" data-copy="robot3">
            <canvas class="still-art still-scene" data-still-form="robot" data-still-phase="0.92" aria-hidden="true"></canvas>
            <div class="copy-right">
              <p class="stanza">And shows what remains open.</p>
            </div>
          </div>
          <div class="copy foot" data-copy="end">
            <div class="copy-center">
              <div class="end-title">
                {/* The artwork draws the FinishUP lockup into this room, as the subject of the line below */}
                <span class="dot-lockup" aria-hidden="true"></span>
                <canvas class="still-art still-lockup" data-still-form="end" data-still-phase="1" aria-hidden="true"></canvas>
                <h2 class="display"><span class="end-subject">FinishUP </span>is <strong>free.</strong></h2>
              </div>
              <p class="stanza center sub">Open source. Local checks on your computer.</p>
              <p class="review-note">Optional AI-powered review may incur provider charges.</p>
              <div class="actions">
                <button class="btn add-agent" type="button" data-prompt={AGENT_PROMPT} hidden>Set up with your agent</button>
                <a class="btn quiet" href={GITHUB} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg> GitHub</a>
              </div>
            </div>
          </div>
          </div>
        </div>
        <div class="spacer" aria-hidden="true"></div>
      </div>

    </main>

    <footer class="footer">
      <div class="footer-inner">
        <a class="lockup" href="#top" aria-label="FinishUP home"><img src="/assets/finishup-lockup.png" alt="FinishUP" height="28" /></a>
        <nav class="footer-links" aria-label="Footer">
          <a href={INSTALL_GUIDE} target="_blank" rel="noopener">Install</a>
          <a href={DOCS} target="_blank" rel="noopener">Docs</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>Contact us</a>
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
        </nav>
        <span class="footer-meta">© 2026 FinishUP</span>
      </div>
    </footer>

    <nav class="scene-rail" id="scene-rail" aria-label="Story scenes" hidden>
      <button type="button" class="rail-dot on" data-scene-target="hero" aria-label="Introduction" aria-current="step"></button>
      <button type="button" class="rail-dot" data-scene-target="alone" aria-label="Working alone"></button>
      <button type="button" class="rail-dot" data-scene-target="swarm" aria-label="Agents working"></button>
      <button type="button" class="rail-dot" data-scene-target="robot1" aria-label="FinishUP checks"></button>
      <button type="button" class="rail-dot" data-scene-target="end" aria-label="FinishUP is free"></button>
    </nav>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden>
      <span class="ok" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg></span>
      <div>
        <p id="toast-title">Copied.</p>
        <p class="sub"><span id="toast-sub"></span><a href={INSTALL_GUIDE} target="_blank" rel="noopener">as shown on GitHub</a>.</p>
      </div>
      <button class="close" type="button" id="toast-close" aria-label="Dismiss"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
    </div>

    <script>
      import { mountParticles, renderStills } from "../scripts/particles.js";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      // In forced colours the artwork's dots carry no reliable contrast, so the story is static.
      const forced = window.matchMedia("(forced-colors: active)");
      const compact = window.matchMedia("(max-height: 560px)");
      const narrow = window.matchMedia("(max-width: 719px)");
      const canvas = document.getElementById("particles") as HTMLCanvasElement | null;
      const story = document.getElementById("story");
      const a11yMenu = document.getElementById("a11y-menu");
      const a11yTrigger = document.getElementById("a11y-trigger") as HTMLButtonElement | null;
      const a11yPanel = document.getElementById("a11y-panel");
      const a11yClose = document.getElementById("a11y-close") as HTMLButtonElement | null;
      const a11yReducedNote = document.getElementById("a11y-reduced-note");
      const motionRow = document.getElementById("motion-row");
      const motionToggle = document.getElementById("motion-toggle") as HTMLButtonElement | null;
      const graphicsRow = document.getElementById("graphics-row");
      const graphicsToggle = document.getElementById("graphics-toggle") as HTMLButtonElement | null;
      const sceneRail = document.getElementById("scene-rail");
      const railDots = Array.from(document.querySelectorAll<HTMLButtonElement>(".rail-dot"));
      const copies = Array.from(document.querySelectorAll<HTMLElement>(".copy"));
      const stillCanvases = Array.from(document.querySelectorAll<HTMLCanvasElement>(".still-art"));
      const mainContent = document.getElementById("main-content");
      const planEl = document.getElementById("story-plan");
      const plan: [string, number][] = planEl ? JSON.parse(planEl.textContent || "[]") : [];
      const lockupSlot = document.querySelector<HTMLElement>('[data-copy="end"] .dot-lockup');
      let pageActive = true;
      // Set when the artwork cannot draw (no context, or WebGL lost for good): the static story.
      let artFailed = false;
      let userPaused = false;
      let userTextOnly = false;
      let layoutFits = true;
      let stopStory = () => {};
      // In the still and text views a copy the reader is put on sits this far below the top of
      // the window: just under the fixed nav.
      const READING_TOP = 88;
      // A place in the story: the copy the reader is on and, when it was read from the animated
      // story, how many screens they had scrolled into it.
      type Place = { copy: string; screens: number | null };
      // Set while the animated story is mounted: reads the reader's place in it, and scrolls to one.
      let animatedStory: { place(): Place; show(place: Place): void } | null = null;
      // The place a switch last put the reader at in the still or text view, with the scroll
      // offset and the window size it left them at. See readingPlace().
      let kept: { place: Place; scrollY: number; windowSize: string } | null = null;
      let stillsWidth = 0;
      let cancelAutoScroll = () => {};

      // Leave room for the copy's drift. Measure without scroll-drift transforms so resizing
      // while scrolled (such as mobile browser bars hiding/showing) never falsely trips fallback.
      function copyFits() {
        if (!canvas || !story) return false;
        const saved = copies.map((el) => el.style.transform);
        for (const el of copies) el.style.transform = "none";
        const stage = canvas.getBoundingClientRect();
        const fits = Array.from(story.querySelectorAll<HTMLElement>(".hero-top, .hero-bottom, .copy-right, .copy-center")).every((el) => {
          const r = el.getBoundingClientRect();
          return r.top >= stage.top + 24 && r.bottom <= stage.bottom - 24
            && r.left >= stage.left && r.right <= stage.right;
        });
        copies.forEach((el, i) => {
          if (saved[i]) el.style.transform = saved[i];
          else el.style.removeProperty("transform");
        });
        return fits;
      }

      function paintStills() {
        if (!stillCanvases.length || typeof renderStills !== "function") return;
        const items = stillCanvases.map((el) => ({
          canvas: el,
          form: el.dataset.stillForm || "hero",
          phase: Number(el.dataset.stillPhase || "0"),
          width: el.clientWidth || (el.classList.contains("still-hero") ? 640 : el.classList.contains("still-lockup") ? 600 : 440),
          height: el.clientHeight || (el.classList.contains("still-hero") ? 180 : el.classList.contains("still-lockup") ? 125 : 320),
        }));
        const ok = renderStills(items, {
          count: narrow.matches ? 2200 : 4200,
          glCount: narrow.matches ? 10000 : 24000,
        });
        if (!ok) {
          artFailed = true;
          syncPresentation();
        } else {
          stillsWidth = innerWidth;
        }
      }

      // Smooth programmatic scroll for scene-rail jumps that yields immediately to any wheel or touch input.
      function scrollToY(targetY: number) {
        cancelAutoScroll();
        if (reduced.matches) {
          window.scrollTo({ top: targetY, behavior: "instant" as ScrollBehavior });
          return;
        }
        const startY = window.scrollY;
        const dist = targetY - startY;
        if (Math.abs(dist) < 2) return;
        const duration = Math.min(720, Math.max(260, Math.abs(dist) * 0.35));
        const t0 = performance.now();
        let rafId = 0;
        const stop = () => {
          cancelAnimationFrame(rafId);
          window.removeEventListener("wheel", stop);
          window.removeEventListener("touchstart", stop);
          window.removeEventListener("pointerdown", stop);
          window.removeEventListener("keydown", stop);
          cancelAutoScroll = () => {};
        };
        cancelAutoScroll = stop;
        window.addEventListener("wheel", stop, { passive: true });
        window.addEventListener("touchstart", stop, { passive: true });
        window.addEventListener("pointerdown", stop, { passive: true });
        window.addEventListener("keydown", stop, { passive: true });
        const step = (now: number) => {
          const p = Math.min(1, (now - t0) / duration);
          const eased = 1 - Math.pow(1 - p, 3);
          window.scrollTo({ top: startY + dist * eased, behavior: "instant" as ScrollBehavior });
          if (p < 1) rafId = requestAnimationFrame(step);
          else stop();
        };
        rafId = requestAnimationFrame(step);
      }

      function setA11yOpen(open: boolean) {
        if (!a11yPanel || !a11yTrigger) return;
        a11yPanel.hidden = !open;
        a11yTrigger.setAttribute("aria-expanded", String(open));
      }

      function syncPresentation() {
        stopStory();
        stopStory = () => {};
        cancelAutoScroll();
        // Canvas support is checked without taking a context: a canvas that hands out a 2D
        // context can never give the artwork WebGL.
        const hasCanvas = !!canvas && typeof CanvasRenderingContext2D !== "undefined" && !!story && plan.length > 0;
        const canDraw = pageActive && !artFailed && !forced.matches && hasCanvas;
        const canAnimate = pageActive && !artFailed && !reduced.matches && !forced.matches && !compact.matches && layoutFits
          && !!canvas && typeof CanvasRenderingContext2D !== "undefined" && !!story && plan.length > 0;
        const animated = canAnimate && !userPaused && !userTextOnly;
        const showStills = !animated && canDraw && !userTextOnly;
        if (a11yMenu) a11yMenu.hidden = !canDraw;
        if (motionToggle) {
          motionToggle.hidden = !canAnimate;
          // Text only also stops the motion, so "Pause motion" reads as on while it is set.
          motionToggle.setAttribute("aria-checked", String(userPaused || userTextOnly));
        }
        if (motionRow) motionRow.hidden = !canAnimate;
        if (a11yReducedNote) a11yReducedNote.hidden = !(canDraw && reduced.matches && !userTextOnly);
        if (graphicsToggle) graphicsToggle.setAttribute("aria-checked", String(userTextOnly));
        if (graphicsRow) graphicsRow.hidden = !canDraw;
        if (sceneRail) sceneRail.hidden = !animated;
        story?.classList.toggle("animated", animated);
        story?.classList.toggle("stills", showStills);
        const spacer = story?.querySelector<HTMLElement>(".spacer");
        const totalScreens = Number(story?.dataset.screens || "0");
        if (spacer && story) {
          const unit = CSS.supports("height", "100svh") ? "svh" : "vh";
          spacer.style.height = animated ? `${totalScreens * 100}${unit}` : "";
        }
        for (const el of copies) {
          el.inert = false;
          el.removeAttribute("aria-hidden");
          el.style.removeProperty("opacity");
          el.style.removeProperty("transform");
          el.classList.add("on");
        }
        if (!animated) {
          if (showStills) paintStills();
          return;
        }
        if (!canvas || !story) return;
        if (!copyFits()) {
          layoutFits = false;
          syncPresentation();
          return;
        }

        // The 2D budget, and the denser one for browsers that can draw the dots with WebGL. The
        // WebGL count follows the area the artwork covers (the engine's px per scene unit,
        // squared): about 12k on a phone, 60k on a laptop and above. In development,
        // ?dots=<count> tries another budget live.
        const tryDots = import.meta.env.DEV ? Number(new URLSearchParams(location.search).get("dots")) : 0;
        const unit = innerWidth < 720 ? innerWidth * 0.42 : Math.min(innerWidth, innerHeight) * 0.46;
        const glCount = tryDots > 0 ? tryDots : Math.round(Math.max(12000, Math.min(60000, 60000 * (unit / 368) ** 2)));
        const blend = 0.28;
        const art = mountParticles(canvas, {
          count: narrow.matches ? 2600 : 5500, glCount, plan, blend, heroHoldAt: 0.14, drawTier: false,
          onUnavailable: () => { artFailed = true; syncPresentation(); },
        });
        if (art.renderer === "none") {
          artFailed = true;
          art.destroy();
          syncPresentation();
          return;
        }
        let raf = 0;
        let mounted = true;
        const start: Record<string, [number, number]> = {};
        let acc = 0;
        for (const [name, len] of plan) { start[name] = [acc, len]; acc += len; }
        const robot = start.robot ?? [0, 3];
        const beat = robot[1] / 3;
        // Each copy beat is timed directly against the particle storm boundaries (`blend`) so
        // outgoing text clears before peak storm and incoming text lands as the new form settles.
        // The three robot beats share one continuous form and crossfade tightly without a blank gap.
        type CopySpec = {
          name: string;
          in0: number; in1: number;
          out0: number; out1: number;
          drift: boolean;
          rail: string;
        };
        const a0 = start.alone?.[0] ?? 0.95;
        const s0 = start.swarm?.[0] ?? 2.2;
        const r0 = robot[0];
        const r1 = r0 + beat;
        const r2 = r0 + 2 * beat;
        const e0 = start.end?.[0] ?? 6.3;
        const COPY_SPECS: CopySpec[] = [
          { name: "hero", in0: -1, in1: -1, out0: a0 - 0.34, out1: a0 - 0.14, drift: true, rail: "hero" },
          { name: "alone", in0: a0 + 0.14, in1: a0 + 0.32, out0: s0 - 0.34, out1: s0 - 0.14, drift: true, rail: "alone" },
          { name: "swarm", in0: s0 + 0.14, in1: s0 + 0.32, out0: r0 - 0.34, out1: r0 - 0.14, drift: true, rail: "swarm" },
          { name: "robot1", in0: r0 + 0.14, in1: r0 + 0.32, out0: r1 - 0.14, out1: r1 + 0.02, drift: true, rail: "robot1" },
          { name: "robot2", in0: r1 - 0.02, in1: r1 + 0.14, out0: r2 - 0.14, out1: r2 + 0.02, drift: true, rail: "robot1" },
          { name: "robot3", in0: r2 - 0.02, in1: r2 + 0.14, out0: e0 - 0.34, out1: e0 - 0.14, drift: true, rail: "robot1" },
          { name: "end", in0: e0 + 0.20, in1: e0 + 0.40, out0: Infinity, out1: Infinity, drift: false, rail: "end" },
        ];
        // Where each copy is at rest: fully shown, its form settled. A click on the rail scrolls
        // to its scene's rest, and a return from the still or text view to the reader's copy's.
        const restAt: Record<string, number> = {
          hero: 0,
          alone: a0 + 0.55,
          swarm: s0 + 0.55,
          robot1: r0 + 0.5,
          robot2: r1 + beat / 2,
          robot3: r2 + beat / 2,
          end: e0 + 0.72,
        };
        // The copy a scroll position belongs to: the one shown there or, in the gap between two
        // where neither is shown, the nearer one. It depends on the position alone, so it is the
        // same scrolling down, scrolling back up, and on a page loaded part-way through the story.
        const copyAt = (screens: number) => {
          let nearest = COPY_SPECS[0];
          let least = Infinity;
          for (const spec of COPY_SPECS) {
            const away = Math.max(0, spec.in0 - screens, screens - spec.out1);
            if (away < least) { nearest = spec; least = away; }
          }
          return nearest;
        };
        const byCopy: Record<string, HTMLElement> = {};
        for (const el of copies) if (el.dataset.copy) byCopy[el.dataset.copy] = el;
        const ease = (v: number) => { const u = Math.max(0, Math.min(1, v)); return u * u * (3 - 2 * u); };
        const screenPx = () => {
          const h = spacer?.offsetHeight || 0;
          if (h > 0 && totalScreens > 0) return h / totalScreens;
          return canvas.clientHeight || 900;
        };
        const update = () => {
          raf = 0;
          const spx = screenPx();
          const screens = Math.max(0, Math.min(totalScreens, -story.getBoundingClientRect().top / spx));
          let active: HTMLElement | undefined;
          for (const spec of COPY_SPECS) {
            const el = byCopy[spec.name];
            if (!el) continue;
            const fadeIn = spec.in0 < 0 ? 1 : ease((screens - spec.in0) / Math.max(0.01, spec.in1 - spec.in0));
            const fadeOut = spec.out0 === Infinity ? 1 : 1 - ease((screens - spec.out0) / Math.max(0.01, spec.out1 - spec.out0));
            const opacity = Math.min(fadeIn, fadeOut);
            let ty = (fadeOut - fadeIn) * 14;
            if (spec.drift) {
              const from = spec.in0 < 0 ? 0 : spec.in0;
              const to = spec.out1 === Infinity ? from + 1 : spec.out1;
              ty += (spec.in0 < 0 ? 0 : 8) - 16 * Math.max(0, Math.min(1, (screens - from) / Math.max(0.01, to - from)));
            }
            el.style.opacity = opacity.toFixed(3);
            el.style.transform = `translateY(${ty.toFixed(1)}px)`;
            const on = opacity > 0.45;
            el.classList.toggle("on", on);
            el.inert = !on;
            el.setAttribute("aria-hidden", String(!on));
            if (on) active = el;
          }
          // The rail's current step is the scene the scroll position is in. It is not taken from
          // the copy that is shown: between scenes no copy is, and the step must not fall back
          // to the first one there.
          const activeRail = copyAt(screens).rail;
          for (const dot of railDots) {
            const isCurrent = dot.dataset.sceneTarget === activeRail;
            dot.classList.toggle("on", isCurrent);
            if (isCurrent) dot.setAttribute("aria-current", "step");
            else dot.removeAttribute("aria-current");
          }
          // Keyboard focus stays in a visible scene when a scroll changes the story.
          const focused = document.activeElement;
          if (focused instanceof HTMLElement && focused.closest(".copy[inert]")) {
            const target = active?.querySelector<HTMLElement>("a, button") ?? mainContent;
            target?.focus({ preventScroll: true });
          }
          // The artwork draws the closing lockup in dots into the room above "is free.".
          const c = canvas.getBoundingClientRect();
          if (lockupSlot) {
            const r = lockupSlot.getBoundingClientRect();
            art.setLockup(r.left + r.width / 2 - c.left, r.top + r.height / 2 - c.top, r.width, r.height);
          }
          art.setScroll(screens);
        };
        const onScroll = () => {
          if (mounted) update();
        };
        const onResize = () => {
          if (mounted && !raf) raf = requestAnimationFrame(update);
        };
        const onRailClick = (e: Event) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const target = btn.dataset.sceneTarget;
          if (!target || !(target in restAt)) return;
          const storyTop = story.getBoundingClientRect().top + window.scrollY;
          scrollToY(Math.max(0, Math.round(storyTop + restAt[target] * screenPx())));
        };
        for (const dot of railDots) dot.addEventListener("click", onRailClick);
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onResize);
        window.addEventListener("load", onResize);
        document.fonts?.ready.then(onResize).catch(() => {});
        update();
        animatedStory = {
          // The exact scroll position goes with the copy, so a return from another view can
          // land on the same spot. Past the story's end the position still counts from its top.
          place() {
            const screens = -story.getBoundingClientRect().top / screenPx();
            return { copy: copyAt(Math.max(0, Math.min(totalScreens, screens))).name, screens };
          },
          // A place read from the still or text view names only a copy; that copy's rest is shown.
          show(place) {
            const screens = place.screens ?? restAt[place.copy] ?? 0;
            const storyTop = story.getBoundingClientRect().top + window.scrollY;
            window.scrollTo({ top: Math.max(0, storyTop + screens * screenPx()), behavior: "instant" as ScrollBehavior });
            update();
          },
        };
        stopStory = () => {
          mounted = false;
          animatedStory = null;
          cancelAnimationFrame(raf);
          for (const dot of railDots) dot.removeEventListener("click", onRailClick);
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onResize);
          window.removeEventListener("load", onResize);
          art.destroy();
        };
      }

      // The two switches change how the story is presented: animated, as stills, or as text. The
      // three lay the story out differently, so a scroll offset in one means nothing in another.
      // What carries over is the reader's place.

      // The reader's copy when the story is laid out as a page (the still and text views): from
      // the top, the first copy that is at least four fifths in the window or, when none is, the
      // copy that has the most of the window. The fixed nav covers the top of the window. A copy
      // a switch has just put under the nav is found again after a small scroll either way.
      // A reader at the end of the page has reached the last copy, whichever copies the last
      // window still shows above it; how many those are depends on the size of the window.
      function copyInView() {
        const last = copies[copies.length - 1]?.dataset.copy;
        const atPageEnd = window.scrollY > 0 && window.scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
        if (last && atPageEnd) return last;
        let fullest = copies[0]?.dataset.copy || "hero";
        let most = 0;
        for (const el of copies) {
          const name = el.dataset.copy;
          const r = el.getBoundingClientRect();
          const shown = Math.min(r.bottom, innerHeight) - Math.max(r.top, READING_TOP);
          if (!name || shown <= 0) continue;
          if (shown >= 0.8 * (r.bottom - r.top)) return name;
          if (shown > most) {
            fullest = name;
            most = shown;
          }
        }
        return fullest;
      }

      // A page of another width or height is laid out anew, and a scroll offset kept from the
      // old one says nothing about it.
      const windowSize = () => `${innerWidth}x${innerHeight}`;

      function readingPlace(): Place {
        if (animatedStory) return animatedStory.place();
        // A reader who has not scrolled since a switch put them here is still where it put
        // them. The page cannot always show that: a short page cannot bring its last copies up
        // under the nav, and an earlier copy then sits there instead.
        if (kept && kept.windowSize === windowSize() && Math.abs(window.scrollY - kept.scrollY) <= 2) return kept.place;
        return { copy: copyInView(), screens: null };
      }

      function showPlace(place: Place) {
        if (animatedStory) {
          animatedStory.show(place);
          kept = null;
          return;
        }
        const target = copies.find((el) => el.dataset.copy === place.copy);
        if (target) {
          const top = target.getBoundingClientRect().top + window.scrollY - READING_TOP;
          window.scrollTo({ top: Math.max(0, top), behavior: "instant" as ScrollBehavior });
        }
        kept = { place, scrollY: window.scrollY, windowSize: windowSize() };
      }

      // Change the presentation and keep the reader on the scene they were on.
      function switchPresentation(change: () => void) {
        const place = readingPlace();
        change();
        syncPresentation();
        showPlace(place);
      }

      reduced.addEventListener("change", syncPresentation);
      forced.addEventListener("change", syncPresentation);
      compact.addEventListener("change", syncPresentation);
      narrow.addEventListener("change", syncPresentation);
      // Recheck after fonts settle or the viewport changes, without remounting artwork
      // on every resize when the animated layout still fits.
      function syncLayout() {
        if (!layoutFits || (story?.classList.contains("animated") && !copyFits())) {
          layoutFits = true;
          syncPresentation();
        } else if (story?.classList.contains("stills") && Math.abs(innerWidth - stillsWidth) > 48) {
          paintStills();
        }
      }
      window.addEventListener("resize", syncLayout);
      document.fonts?.ready.then(() => {
        syncLayout();
        if (story?.classList.contains("stills")) paintStills();
      }).catch(() => {});

      a11yTrigger?.addEventListener("click", () => {
        const open = !!a11yPanel?.hidden;
        setA11yOpen(open);
      });
      a11yClose?.addEventListener("click", () => {
        setA11yOpen(false);
        a11yTrigger?.focus();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && a11yPanel && !a11yPanel.hidden) {
          setA11yOpen(false);
          a11yTrigger?.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (a11yPanel && !a11yPanel.hidden && a11yMenu && !a11yMenu.contains(e.target as Node | null)) {
          setA11yOpen(false);
        }
      });
      motionToggle?.addEventListener("click", () => {
        switchPresentation(() => {
          if (userTextOnly) {
            userTextOnly = false;
            userPaused = false;
          } else {
            userPaused = !userPaused;
          }
        });
      });
      graphicsToggle?.addEventListener("click", () => {
        switchPresentation(() => { userTextOnly = !userTextOnly; });
      });
      window.addEventListener("pagehide", () => { pageActive = false; stopStory(); });
      window.addEventListener("pageshow", (e) => {
        if (!e.persisted && pageActive) return; // the first load, already presented
        pageActive = true;
        syncPresentation();
      });
      syncPresentation();

      // --- Copy the agent setup prompt ---
      const toast = document.getElementById("toast");
      const toastTitle = document.getElementById("toast-title");
      const toastSub = document.getElementById("toast-sub");
      const toastClose = document.getElementById("toast-close");
      let hideTimer = 0;
      let toastHovered = false;
      async function copyText(text: string): Promise<boolean> {
        if (!text) return false;
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      }
      // The toast's second line ends with the link to the install guide on GitHub.
      function show(title: string, sub: string) {
        if (!toast || !toastTitle || !toastSub) return;
        toastTitle.textContent = title;
        toastSub.textContent = sub;
        toast.hidden = false;
        hideSoon();
      }
      // The toast leaves on its own after a while, but never while the pointer or keyboard
      // focus is on it (its link has to stay reachable).
      function hideSoon() {
        window.clearTimeout(hideTimer);
        if (toastHovered || toast?.contains(document.activeElement)) return;
        hideTimer = window.setTimeout(() => {
          if (toast && !toastHovered && !toast.contains(document.activeElement)) toast.hidden = true;
        }, 9000);
      }
      toast?.addEventListener("pointerenter", () => { toastHovered = true; window.clearTimeout(hideTimer); });
      toast?.addEventListener("focusin", () => window.clearTimeout(hideTimer));
      toast?.addEventListener("pointerleave", () => { toastHovered = false; hideSoon(); });
      toast?.addEventListener("focusout", (e) => { if (!toast.contains(e.relatedTarget as Node | null)) hideSoon(); });
      toastClose?.addEventListener("click", () => { if (toast) toast.hidden = true; });
      for (const el of Array.from(document.querySelectorAll<HTMLButtonElement>(".add-agent"))) {
        el.hidden = false;
        el.addEventListener("click", async () => {
          const ok = await copyText(el.dataset.prompt ?? "");
          show(
            ok ? "Copied the setup instructions for your agent." : "Copy blocked by the browser.",
            ok ? "Paste them into Codex, Claude Code or Cursor. Or install with PyPI or npm, " : "Install with PyPI or npm instead, ",
          );
        });
      }
    </script>
  </body>
</html>
